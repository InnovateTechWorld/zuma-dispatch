# Copy to .env for local development (wrangler dev reads it). In production each
# value is a Worker secret: `npx wrangler secret put NAME`.
# The server refuses to serve tools unless the Paystack and NIPOST keys are TEST keys.

# Paystack test secret key (Dashboard -> Settings -> API Keys & Webhooks). Must start with sk_test_.
PAYSTACK_TEST_SECRET_KEY=sk_test_xxx
# Not used by the server (checkout is hosted by Paystack); kept for reference only.
PAYSTACK_TEST_PUBLIC_KEY=pk_test_xxx

# NIPOST Postcode API test key (dashboard.postcode.gov.ng -> Settings -> API Keys). Must start with nipost_test_.
NIPOST_API_KEY=nipost_test_xxx

# Optional providers. Leave empty to skip them in the chains.
OPENROUTE_BASIC_KEY=
GOOGLE_MAPS_API_KEY=

# Secrets this project generates itself: `openssl rand -hex 32` / `openssl rand -hex 16`.
# Chord sends MCP_BEARER_TOKEN as "Authorization: Bearer ..." on every tool call.
MCP_BEARER_TOKEN=
# Password for the dispatcher board sign-in page at /board/login (16+ chars). Scripts may also send it
# as HTTP Basic auth (any username). Changing it signs every dispatcher out.
BOARD_TOKEN=

# Optional: Chord webhook signing secret (Admin -> Developer -> Webhooks), for handover alerts on the board.
CHORD_WEBHOOK_SECRET=

# Optional: Google Sheet mirror. Spreadsheet id from its URL, and a service-account JSON key (one line)
# whose client_email has Editor access to that sheet. See docs/FEATURES.md section 12.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Leave unset. "1" lets a LOCAL dev server write to the sheet (use a separate test sheet then).
SHEET_MIRROR_ALLOW_LOCAL=
