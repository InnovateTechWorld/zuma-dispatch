{
  "name": "zuma-dispatch-agent",
  "version": "0.1.0",
  "private": true,
  "description": "MCP tool server for a Chord WhatsApp dispatch teammate (mock Abuja courier).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply zuma_dispatch_v2 --local",
    "db:migrate:remote": "wrangler d1 migrations apply zuma_dispatch_v2 --remote",
    "tail": "wrangler tail --format pretty"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.2"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261019.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  }
}
