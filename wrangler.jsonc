{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zuma-dispatch",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zuma_dispatch_v2",
      "database_id": "acae9ac6-c030-499b-9126-4d6a71fa32f2",
      "migrations_dir": "migrations"
    }
  ],
  // Non-secret configuration. Secrets (API keys, tokens) are set with
  // `wrangler secret put` in production and read from .env in local dev.
  "vars": {
    "BUSINESS_NAME": "Zuma Dispatch",
    "BUSINESS_CITY": "Abuja and Lagos",
    "GEOCODER_CHAIN": "google,nominatim,photon,ors",
    "GEOCODER_MODE": "crosscheck",
    "ROUTER_CHAIN": "osrm,ors,straight_line",
    "QUOTE_TTL_MINUTES": "30",
    "PROVIDER_TIMEOUT_MS": "4000",
    "CHORD_API_BASE": "https://api.chordhq.xyz",
    "CHORD_WORKSPACE_ID": "ws-6f317367-26a3-4b04-b40e-c3d301b450f5",
    "CHORD_TEAMMATE_ID": "668480f8-a26a-43b6-9a32-ea9156f2fb4a",
    "CHORD_NOTICE_ROUTE": "auto"
  }
}
