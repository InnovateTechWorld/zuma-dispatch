  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Outlined default button; rows use the small size.",
      "html": "<button class=\"ds-btn\">Mark delivered</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;height:var(--control,2.75rem);padding:0 1rem;border:1px solid var(--color-rule-2);border-radius:6px;background:var(--color-surface);color:var(--color-ink);font:500 .875rem/1 Inter,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color 160ms cubic-bezier(0.16,1,0.3,1),border-color 160ms cubic-bezier(0.16,1,0.3,1)}.ds-btn:hover{border-color:var(--color-ink-2);background:var(--color-paper-2)}.ds-btn:active{background:var(--color-rule)}.ds-btn:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one filled button per view.",
      "html": "<button class=\"ds-btn-primary\">Search</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;height:2.75rem;padding:0 1rem;border:1px solid var(--color-accent);border-radius:6px;background:var(--color-accent);color:var(--color-accent-ink);font:500 .875rem/1 Inter,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color 160ms cubic-bezier(0.16,1,0.3,1)}.ds-btn-primary:hover{background:var(--color-accent-hover);border-color:var(--color-accent-hover)}.ds-btn-primary:active{background:var(--color-accent-text)}.ds-btn-primary:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "input",
      "description": "1 px border in every state, focus outline, reserved helper line.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field__l\">Board password</span><input class=\"ds-input\" type=\"password\"><span class=\"ds-helper\">That password is not right.</span></label>",
      "css": ".ds-field{display:grid;gap:.25rem}.ds-field__l{font:500 .875rem/1.3 Inter,sans-serif;color:var(--color-ink)}.ds-input{height:2.75rem;padding:0 .75rem;border:1px solid var(--color-rule-2);border-radius:6px;background:var(--color-surface);color:var(--color-ink);font:400 .9375rem/1 Inter,sans-serif}.ds-input:hover{border-color:var(--color-ink-2)}.ds-input:focus-visible{outline:2px solid var(--color-focus);outline-offset:1px;border-color:var(--color-focus)}.ds-helper{min-height:1lh;font-size:.875rem;color:var(--color-bad)}"
    },
    {
      "name": "Tab row with badges",
      "kind": "nav",
      "refersTo": "tab",
      "description": "Desktop tabs; current is underlined in cobalt; urgent badges are red.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-tab\" aria-current=\"page\" href=\"#\">Home</a><a class=\"ds-tab\" href=\"#\">Deliveries<span class=\"ds-count\">3</span></a><a class=\"ds-tab\" href=\"#\">Handovers<span class=\"ds-count ds-count--urgent\">3</span></a><a class=\"ds-tab\" href=\"#\">Payments</a><a class=\"ds-tab\" href=\"#\">System</a></nav>",
      "css": ".ds-nav{display:flex;gap:1.5rem;border-bottom:1px solid var(--color-rule)}.ds-tab{position:relative;display:inline-flex;align-items:center;gap:.5rem;min-height:2.75rem;color:var(--color-ink-2);text-decoration:none;font:500 .875rem/1 Inter,sans-serif;transition:color 160ms}.ds-tab:hover{color:var(--color-ink)}.ds-tab:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px}.ds-tab[aria-current=\"page\"]{color:var(--color-ink);font-weight:600}.ds-tab[aria-current=\"page\"]::after{content:\"\";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:var(--color-accent)}.ds-count{display:inline-flex;align-items:center;justify-content:center;min-width:1.25rem;height:1.25rem;padding:0 .3125rem;border-radius:999px;background:var(--color-paper-2);border:1px solid var(--color-rule-2);color:var(--color-ink-2);font:600 .6875rem/1 Inter,sans-serif}.ds-count--urgent{background:var(--color-bad);border-color:var(--color-bad);color:var(--color-accent-ink)}"
    },
    {
      "name": "Status pill",
      "kind": "chip",
      "refersTo": "pill",
      "description": "Job status as text, dot and border in the status colour.",
      "html": "<span class=\"ds-pill\">paid</span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:.25rem;height:1.5rem;padding:0 .5rem;border:1px solid currentColor;border-radius:999px;font:500 .75rem/1 Inter,sans-serif;color:var(--st-paid)}.ds-pill::before{content:\"\";width:.375rem;height:.375rem;border-radius:50%;background:currentColor}"
    },
    {
      "name": "Needs-you alert row",
      "kind": "custom",
      "refersTo": "alert-row-urgent",
      "description": "Home alert: full-width link, tone pill, one CTA; urgent rows tinted.",
      "html": "<a class=\"ds-alert ds-alert--urgent\" href=\"#\"><span><span class=\"ds-alert__t\">3 chats are waiting for a person <span class=\"ds-tone\">Urgent</span></span><span class=\"ds-alert__d\">Zuma handed these customers to the team.</span></span><span class=\"ds-alert__cta\">Open handovers</span></a>",
      "css": ".ds-alert{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.5rem 1.5rem;align-items:center;padding:1rem;border:1px solid var(--color-rule);border-radius:10px;background:var(--color-surface);color:var(--color-ink-2);text-decoration:none;transition:background-color 160ms}.ds-alert:hover{background:var(--color-paper-2)}.ds-alert:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px}.ds-alert--urgent,.ds-alert--urgent:hover{background:var(--color-bad-wash)}.ds-alert__t{display:flex;flex-wrap:wrap;align-items:center;gap:.25rem .75rem;font:600 1.0625rem/1.3 \"Space Grotesk\",sans-serif;color:var(--color-ink)}.ds-tone{display:inline-flex;align-items:center;gap:.25rem;height:1.375rem;padding:0 .5rem;border:1px solid currentColor;border-radius:999px;font:500 .75rem/1 Inter,sans-serif;color:var(--color-bad)}.ds-tone::before{content:\"\";width:.375rem;height:.375rem;border-radius:50%;background:currentColor}.ds-alert__d{display:block;margin-top:.25rem;font-size:.875rem}.ds-alert__cta{font:500 .875rem Inter,sans-serif;color:var(--color-accent-text);white-space:nowrap}.ds-alert:hover .ds-alert__cta{text-decoration:underline}"
    },
    {
      "name": "Team notice",
      "kind": "custom",
      "refersTo": "team-notice",
      "description": "The owner announcement on Home and sign-in.",
      "html": "<div class=\"ds-announce\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 10v4a1 1 0 0 0 1 1h2l6 4V5L7 9H5a1 1 0 0 0-1 1z\"/><path d=\"M16.5 9a4 4 0 0 1 0 6\"/></svg><span><b>Team notice:</b> Lagos riders are off on Sunday.</span></div>",
      "css": ".ds-announce{display:flex;gap:.75rem;align-items:flex-start;padding:.75rem 1rem;border:1px solid var(--color-accent);border-radius:6px;background:var(--color-accent-wash);color:var(--color-ink);font:400 .875rem/1.55 Inter,sans-serif}.ds-announce svg{width:1.125rem;height:1.125rem;flex:none;color:var(--color-accent-text)}.ds-announce b{font-weight:600}"
    },
    {
      "name": "Empty state",
      "kind": "card",
      "refersTo": "empty-state",
      "description": "Says what would appear and why it is empty.",
      "html": "<div class=\"ds-blank\"><b>Nothing to review.</b> A payment lands here only when Paystack’s numbers disagree with the quote.</div>",
      "css": ".ds-blank{padding:2rem 1rem;border:1px dashed var(--color-rule-2);border-radius:10px;color:var(--color-ink-2);font:400 .875rem/1.55 Inter,sans-serif}.ds-blank b{display:block;color:var(--color-ink);font:600 1.0625rem/1.3 \"Space Grotesk\",sans-serif;margin-bottom:.25rem}"
    },
    {
      "name": "Theme switch",
      "kind": "custom",
      "description": "Segmented Match device / Light / Dark form buttons; pressed is cobalt wash.",
      "html": "<span class=\"ds-theme\" role=\"group\" aria-label=\"Theme\"><button aria-pressed=\"false\">Auto</button><button aria-pressed=\"true\">Light</button><button aria-pressed=\"false\">Dark</button></span>",
      "css": ".ds-theme{display:inline-flex;border:1px solid var(--color-rule-2);border-radius:6px;overflow:hidden}.ds-theme button{height:calc(2.25rem - 2px);padding:0 .75rem;border:0;background:transparent;color:var(--color-muted);font:500 .75rem Inter,sans-serif;cursor:pointer;transition:background-color 160ms,color 160ms}.ds-theme button+button{border-left:1px solid var(--color-rule)}.ds-theme button:hover{background:var(--color-paper-2);color:var(--color-ink)}.ds-theme button:focus-visible{outline:2px solid var(--color-focus);outline-offset:-2px}.ds-theme button[aria-pressed=\"true\"]{background:var(--color-accent-wash);color:var(--color-accent-text)}"
    }
  ],
  "narrative": {
    "northStar": "The Instrument Panel",
    "overview": "Calm and precise, with real numbers only and no marketing copy. The audience is the dispatcher and the business owner, on a laptop at a desk or a phone on the move; on `/pay/return`, a WhatsApp customer for a few seconds. They come to see what is waiting, advance a job, check how a payment was confirmed, and find one delivery fast.\n\nGenre: modern-minimal. Theme: Cobalt. Cool near-white paper, one electric-blue signal, hairline structure, tight 6 px radii. The board is a tabbed workbench: each tab holds one job, and Home is an inbox of the things that need a person. Deviations from Cobalt: no ⌘K palette and no reveal animation. The CSP allows **no scripts**, so every control (tabs, sub-tabs, filters, theme switch, actions, sign-out) is a link or a form and works with JavaScript off.",
    "keyCharacteristics": [
      "Five tabs, each a real URL; sub-views are links with their own URLs too.",
      "Hairlines separate everything; no shadows, no boxed marketing cards.",
      "One accent, used for the current tab, the primary action, focus and the brand mark.",
      "Light, dark, or match device, chosen per browser and rendered on the server.",
      "Every figure is a D1 count labelled with what it counts and over which period."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "The accent covers less than 5% of any screen. Row buttons are outlined. A filled primary button appears once per view: Search, Sign in, Send, Take over, or the next step on a job page.",
        "section": "colors"
      },
      {
        "name": "The Text Too Rule",
        "body": "Colour never carries state alone. Every pill, tone, chip and badge also carries its meaning as text (or screen-reader text for badges).",
        "section": "colors"
      },
      {
        "name": "The Upright Rule",
        "body": "Headings are never italic. Numbers use tabular figures (`.num`).",
        "section": "typography"
      },
      {
        "name": "The No-Kicker Rule",
        "body": "No labels above headings: no eyebrow, kicker or small caption over an h1, h2 or h3. A page title starts the page; a section head starts its section. The job page's back link (\"← Deliveries\") is navigation, not a label, and is the one thing allowed above an h1. Mono labels name data (table heads, fact terms, figure terms, chart captions); they never introduce a heading.",
        "section": "typography"
      },
      {
        "name": "The No Sideways Rule",
        "body": "No horizontal page scroll at 320 / 375 / 414 / 768 px (`overflow-x: clip` on html and body). No clickable text wraps. Wide data tables scroll inside their own frame.",
        "section": "layout"
      },
      {
        "name": "The Hairline Rule",
        "body": "Sections are separated by a 1 px rule, never by a shadow or a filled card.",
        "section": "elevation & depth"
      }
    ],
    "dos": [
      "Do take every colour and font from a token. Add any new value to `layout.ts` as a token first.",
      "Do label every figure with what it counts and over which period (days are WAT). Every figure is a D1 count.",
      "Do give every list one CTA per row and every view one filled primary button.",
      "Do make every control a link or a form, so it works with scripts off.",
      "Do pass every interpolated value through `escapeHtml`.",
      "Do keep sub-views on their own URLs so they can be shared and refreshed."
    ],
    "donts": [
      "Don't put a label, eyebrow or kicker above a heading.",
      "Don't use the graphite band anywhere but Deliveries › Overview.",
      "Don't add shadows or filled cards; separate with hairlines.",
      "Don't let colour alone carry a state.",
      "Don't invent numbers or show zeros as a chart.",
      "Don't cause horizontal page scroll at 320 px or wrap clickable text."
    ]
  }
}